# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://ppanel:ppanel@127.0.0.1:3306/ppanel"
MARIADB_ROOT_PASSWORD="rootpw"
MARIADB_DATABASE="ppanel"
MARIADB_USER="ppanel"
MARIADB_PASSWORD="ppanel"
MARIADB_PORT="3306"

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# 32 random bytes, base64. Encrypts GSLT tokens, RCON and join passwords at rest.
# Generate with:  openssl rand -base64 32
# Rotating this value makes every stored secret unreadable.
PPANEL_SECRET_KEY=""

# Signs panel session cookies. Generate with: openssl rand -base64 32
PPANEL_SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Hub (agent gateway)
# ---------------------------------------------------------------------------
HUB_HOST="0.0.0.0"
HUB_PORT="4000"
# Public ws(s):// URL agents dial from game hosts. MUST be reachable from the
# internet (not 127.0.0.1). Example: ws://pm.denello.ru:4000 — open/forward
# that port to the machine running the hub, or put a reverse proxy in front.
HUB_PUBLIC_URL="ws://pm.denello.ru:4000"
# Shared secret between panel and hub for the internal control API.
HUB_INTERNAL_TOKEN=""

# ---------------------------------------------------------------------------
# Panel (Next.js)
# ---------------------------------------------------------------------------
PANEL_PORT="3000"
# Panel → hub over the public hostname (not 127.0.0.1/localhost).
HUB_INTERNAL_URL="http://pm.denello.ru:4000"
# Comma-separated hostnames allowed to load Next.js dev assets via reverse proxy.
# PANEL_DEV_ORIGINS="pm.denello.ru"

# ---------------------------------------------------------------------------
# Agent defaults pushed during SSH bootstrap
# ---------------------------------------------------------------------------
# ONLY this image is installed on game hosts (not the panel/hub site).
# Built by .github/workflows/publish-agent.yml → GHCR package ez-agent (must be Public).
# Keep this package Public — game hosts pull without docker login.
# Repo on GitHub is just the build source; hosts never clone it.
AGENT_IMAGE="ghcr.io/denelloff/ez-agent:latest"
AGENT_CONTAINER_NAME="ez-agent"
AGENT_DOCKER_NETWORK="ppanel"
# Refuse agent bootstrap below this much free disk (~2 GiB is enough to pull the agent).
AGENT_MIN_FREE_BYTES="2147483648"
# Refuse CS2 instance.create below this (~85 GiB: game + SteamCMD headroom).
CS2_MIN_FREE_BYTES="92274688000"
