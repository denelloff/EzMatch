# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://ppanel:ppanel@127.0.0.1:3306/ppanel"
MARIADB_ROOT_PASSWORD="rootpw"
MARIADB_DATABASE="ppanel"
MARIADB_USER="ppanel"
MARIADB_PASSWORD="ppanel"
MARIADB_PORT="3306"

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# 32 random bytes, base64. Encrypts GSLT tokens, RCON and join passwords at rest.
# Generate with:  openssl rand -base64 32
# Rotating this value makes every stored secret unreadable.
PPANEL_SECRET_KEY=""

# Signs panel session cookies. Generate with: openssl rand -base64 32
PPANEL_SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Hub (agent gateway)
# ---------------------------------------------------------------------------
HUB_HOST="0.0.0.0"
HUB_PORT="4000"
# Public wss:// URL the agents dial back to. Must be reachable from game hosts.
HUB_PUBLIC_URL="ws://127.0.0.1:4000"
# Shared secret between panel and hub for the internal control API.
HUB_INTERNAL_TOKEN=""

# ---------------------------------------------------------------------------
# Panel (Next.js)
# ---------------------------------------------------------------------------
PANEL_PORT="3000"
HUB_INTERNAL_URL="http://127.0.0.1:4000"

# ---------------------------------------------------------------------------
# Agent defaults pushed during SSH bootstrap
# ---------------------------------------------------------------------------
# Image the remote host will `docker pull`. Published by
# .github/workflows/publish-agent.yml to:
#   ghcr.io/denelloff/ppanel-agent:0.1.0
# After the first successful Actions run, set the package visibility to Public
# (Packages → ppanel-agent → Package settings) if the workflow could not.
AGENT_IMAGE="ghcr.io/denelloff/ppanel-agent:0.1.0"
AGENT_CONTAINER_NAME="ppanel-agent"
AGENT_DOCKER_NETWORK="ppanel"
# Refuse to install CS2 below this much free disk. The game is roughly 60 GB.
AGENT_MIN_FREE_BYTES="85899345920"
