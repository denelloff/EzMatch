# Agent runtime (set by bootstrap on the game host; useful for local runs too).
PPANEL_SERVER_ID=""
PPANEL_AGENT_TOKEN=""
# Hub WebSocket URL the agent dials (must start with ws:// or wss://).
PPANEL_HUB_URL="ws://127.0.0.1:4000"

# Optional overrides
# PPANEL_NETWORK="ppanel"
# PPANEL_LOG_PORT="8787"
# PPANEL_AGENT_HOST="ez-agent"
# PPANEL_STATE_DIR="/var/lib/ppanel"
# PPANEL_CS2_IMAGE="joedwards32/cs2:latest"

# Image published by CI (game hosts pull this; keep the GHCR package Public).
AGENT_IMAGE="ghcr.io/denelloff/ez-agent:latest"
AGENT_CONTAINER_NAME="ez-agent"
