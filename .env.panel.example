# Copy to .env.panel and fill in. Used by docker-compose.panel.yml.

PANEL_PORT=3000

# Existing MariaDB (external address of the DB host)
DATABASE_URL=mysql://PMatch:CHANGE_ME@128.0.141.214:3306/PMatch

PPANEL_SECRET_KEY=CHANGE_ME
HUB_INTERNAL_TOKEN=CHANGE_ME

# Hub from the panel container. Examples:
#   http://host.docker.internal:4000   — hub on the Docker host
#   http://192.168.0.96:4000           — hub on another LAN machine
#   http://ez-hub:4000                 — hub in the same compose network
HUB_INTERNAL_URL=http://host.docker.internal:4000
HUB_PUBLIC_URL=ws://pm.denello.ru:4000
