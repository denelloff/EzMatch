{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/forms/**",
              "components/match/**",
              "components/navigation/**",
              "ui_kits/panel/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Chakra Petch|Manrope|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Chakra Petch, Manrope, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|live|style|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, live, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|warn|danger|info|brand|neutral)$/]",
        "message": "<Badge> tone must be one of 'ok' | 'warn' | 'danger' | 'info' | 'brand' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|disabled|type|href|style|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, disabled, type, href, style, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:inset|style|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: inset, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|defaultChecked|disabled|name|onChange|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, defaultChecked, disabled, name, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|href|active|style|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: as, href, active, style, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:span|button)$/]",
        "message": "<Chip> as must be one of 'span' | 'button'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, description, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedEvent'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|kind|category|detail|key|ref|className|style|children)$/]",
        "message": "<FeedEvent> doesn't accept that prop. Declared props: time, kind, category, detail."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedEvent'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:match|combat|connection|server|chat|economy|other)$/]",
        "message": "<FeedEvent> category must be one of 'match' | 'combat' | 'connection' | 'server' | 'chat' | 'economy' | 'other'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|value|defaultValue|placeholder|disabled|invalid|name|style|onChange|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: type, value, defaultValue, placeholder, disabled, invalid, name, style, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|password|email|number|search)$/]",
        "message": "<Input> type must be one of 'text' | 'password' | 'email' | 'number' | 'search'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LanguageToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:locale|onChange|labels|key|ref|className|style|children)$/]",
        "message": "<LanguageToggle> doesn't accept that prop. Declared props: locale, onChange, labels."
      },
      {
        "selector": "JSXOpeningElement[name.name='LanguageToggle'] > JSXAttribute[name.name='locale'] > Literal[value!=/^(?:en|ru)$/]",
        "message": "<LanguageToggle> locale must be one of 'en' | 'ru'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:mark|size|subtitle|href|src|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: mark, size, subtitle, href, src, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='mark'] > Literal[value!=/^(?:shard|bracket|reticle|caret)$/]",
        "message": "<Logo> mark must be one of 'shard' | 'bracket' | 'reticle' | 'caret'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Logo> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchTableRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|shortId|team1Name|team2Name|team1Score|team2Score|map|serverName|instanceName|state|key|ref|className|style|children)$/]",
        "message": "<MatchTableRow> doesn't accept that prop. Declared props: id, shortId, team1Name, team2Name, team1Score, team2Score, map, serverName, instanceName, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchTableRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:DRAFT|WARMUP|KNIFE|KNIFE_DECISION|LIVE|PAUSED|HALFTIME|OVERTIME|FINISHED|CANCELLED)$/]",
        "message": "<MatchTableRow> state must be one of 'DRAFT' | 'WARMUP' | 'KNIFE' | 'KNIFE_DECISION' | 'LIVE' | 'PAUSED' | 'HALFTIME' | 'OVERTIME' | 'FINISHED' | 'CANCELLED'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|style|children|key|ref|className|style|children)$/]",
        "message": "<Notice> doesn't accept that prop. Declared props: tone, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:warn|danger|info)$/]",
        "message": "<Notice> tone must be one of 'warn' | 'danger' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreboardPlayer'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|kills|assists|deaths|damage|connected|key|ref|className|style|children)$/]",
        "message": "<ScoreboardPlayer> doesn't accept that prop. Declared props: name, kills, assists, deaths, damage, connected."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|placeholder|value|defaultValue|disabled|name|style|onChange|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, placeholder, value, defaultValue, disabled, name, style, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|count|key|ref|className|style|children)$/]",
        "message": "<SidebarNavItem> doesn't accept that prop. Declared props: href, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|hint|tone|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, hint, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|ok)$/]",
        "message": "<StatTile> tone must be one of 'neutral' | 'brand' | 'ok'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|percent|state|eta|key|ref|className|style|children)$/]",
        "message": "<TaskProgress> doesn't accept that prop. Declared props: label, percent, state, eta."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskProgress'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:running|done|failed)$/]",
        "message": "<TaskProgress> state must be one of 'running' | 'done' | 'failed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|count|key|ref|className|style|children)$/]",
        "message": "<TopNavItem> doesn't accept that prop. Declared props: href, label, count."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
