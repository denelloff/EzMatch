{
  "name": "ezmatch-agent",
  "version": "0.1.0",
  "private": true,
  "description": "eZ-Match game-host agent (GHCR image ez-agent)",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "typecheck": "pnpm -r typecheck",
    "dev:agent": "pnpm --filter @ppanel/agent dev",
    "build:agent": "pnpm --filter @ppanel/protocol build && pnpm --filter @ppanel/agent build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2"
  }
}
