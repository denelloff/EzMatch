{
  "name": "@ppanel/hub",
  "version": "0.1.0",
  "private": true,
  "description": "eZ-Match control hub",

  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ppanel/db": "workspace:^",
    "@ppanel/protocol": "workspace:^",
    "fastify": "^5.11.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ssh2": "^1.17.0",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2"
  }
}
